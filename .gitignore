# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# pwa - generated service worker (Serwist generates it on `next build`)
/public/sw.js
/public/workbox-*.js

# jwpub - binary program files, local only
/jwpub/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# impeccable - local-only runtime (shared config stays committed)
.impeccable/config.local.json
.impeccable/live/sessions/
.impeccable/live/inject-journal.json
.impeccable/live/roots.json
.impeccable/*.log
.claude/settings.local.json

# skills vendor - instalação local (cada dev instala; launcher baixa o binário)
.claude/skills/
.claude/agents/
.opencode/skills/
.opencode/commands/

# typescript
*.tsbuildinfo
next-env.d.ts
